.search{
  width: 100%;
  height: 50px;
  background-color: #c00000;
  padding: 7px 15px;
  box-sizing: border-box;
}
.search_in{
  width: 100%;
  height: 35px;
  background-color: #fff;
  /* 圆角 */
  border-radius: 20px;
  /* 水平居中 */
  text-align: center;
  /* 垂直 文字 */
  line-height: 35px;
}
page{
  height: 100%;
}
.box{
  width: 100%;
  height: 100%;
  display: flex;
}
.box_left{
  width: 100px;
  height: 100%;
  background-color: #f7f7f7;
}
.box_left view{
  width: 100px;
  height: 50px;
  /* background-color: pink; */
  text-align: center;
  line-height: 50px;
}
.box_right{
  flex: 1;
  height: 100%;
  background-color: white;
  text-align: center;
}
.title{
  margin: 10px 0;
  font-weight: 700;
}
.main{
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}
.main_in{
 width: 30%;
 margin: 5px 0px;
}
.main_in image{
  width: 100%;
  height: 50px;
}
.bg{
    background-color: white;
}
