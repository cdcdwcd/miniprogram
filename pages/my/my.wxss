page{
  width: 100%;
  height: 100%;
  background-color: #f4f4f4;
}
.avatar{
  width: 100%;
  height: 200px;
  background-color: #c00000;
  text-align: center;
}
.avatar image{
  width: 100px;
  height: 100px;
  border-radius: 50px;
  margin-top: 50px;
}
.avatar view{
  color: #fff;
  font-size: 18px;
}
.news{
  width: 92%;
  height: 60px;
  background-color: #fff;
  display: flex;
  text-align: center;
  justify-content: space-around;
  margin-top: -10px;
  margin-left: 15px;
  align-items: center;
}
.list_in{
  width: 92%;
  height: 40px;
  background-color: #fff;
  margin-left: 15px;
  display: flex;
  justify-content: space-between;
  padding: 0 10px;
  box-sizing: border-box;
  align-items: center;
  margin-top: 10px;
}