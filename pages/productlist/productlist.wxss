.list{
  padding: 5px;
  display: flex;
  height: 135px;
  box-sizing: border-box;
}
.left image{
  width: 120px;
  height: 120px;
}
.right{
  flex: 1;
  margin-left: 10px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 5px;
  box-sizing: border-box;
  font-size: 14px;
}
.price{
  color: #c00000;
  font-weight: 700;
  font-size: 16px;
}