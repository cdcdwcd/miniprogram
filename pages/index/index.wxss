.search{
    width: 100%;
    height: 50px;
    background-color: #c00000;
    padding: 7px 15px;
    box-sizing: border-box;
}
.search_in{
    width: 100%;
    height: 35px;
    background-color: #ffffff;
    border-radius: 20px;
    text-align: center;
    line-height: 35px;
}

.sw{
    width: 100%;
    height: 200px;
}
.sw image{
    width: 100%;
    height: 200px;
}

.nav{
    width: 100%;
    height: 110px;
}
.nav image{
    width: 25%;
    height: 110px;
}

.main{
    padding: 10px;
}
.main_top image{
    width: 100%;
    height: 50px;
}
.main_bottom{
    display: flex;
}
.bottom_left{
    width: 30%;
    height: 251px;
}
.bottom_left image{
    width: 100%;
    height: 251px;
}
.bottom_right{
    width: 70%;
    height: 251px;
}
.bottom_right image{
    width: 46%;
    margin-left: 5px;
    height: 125px;
}

