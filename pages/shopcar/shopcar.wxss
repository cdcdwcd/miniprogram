page,.box{
  width: 100%;
  height: 100%;
}
.box_top{
  width: 100%;
  height: 120px;
  display: flex;
  align-items: center;
}
.line{
  width: 100%;
  height: 10px;
}
.car{
  height: 40px;
  display: flex;
  align-items: center;
}
.car image{
  width: 20px;
  height: 20px;
  margin: 0 10px;
}
.list{
  height: 120px;
  border-top: 1px solid #ccc;
  display: flex;
  padding: 8px;
}
.list image{
  width: 120px;
  height: 120px;
}
.right{
  flex: 1;
  margin-left: 5px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.info_bottom{
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.price{
  color: #c00000;
  font-size: 18px;
  font-weight: 500;
}
.number{
  width: 100px;
  height: 40px;
  border: 1px solid #ccc;
  display: flex;
}
.number view{
  flex: 1;
  text-align: center;
  line-height: 40px;
}
.parent{
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 50px;
  position: fixed;
  bottom: 0;
  left: 0;
  background-color: #fff;
}
.par_right{
  width: 100px;
  height: 50px;
  background-color: #c00000;
  color: #fff;
  text-align: center;
  line-height: 50px;
}
.p{
  color: #c00000;
}