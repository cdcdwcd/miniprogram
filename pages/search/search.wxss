.search{
  width: 100%;
  height: 50px;
  background-color: #c00000;
  padding: 6px 15px;
  box-sizing: border-box;
}
input{
  width: 100%;
  height: 38px;
  background-color: #fff;
  border-radius: 19px;
  padding-left: 20px;
  box-sizing: border-box;
}
.his_top{
  width: 100%;
  height: 50px;
  border-bottom: 1px solid #ccc;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 10px;
  box-sizing: border-box;
}
.his_top image{
  width: 22px;
  height: 22px;
}
.his_bottom{
  padding-top: 10px;
}
.his_bottom text{
  margin: 0px 15px;
}
.list{
  margin-top: 10px;
}
.list_in {
  height: 50px;
  display: flex;
  justify-content: space-between;
  padding: 0 10px;
  border-bottom: 1px solid #ccc;
  align-items: center;

}
.list_in view:nth-child(1){
  flex: 1;
  overflow: hidden; /* 隐藏溢出内容 */
  white-space: nowrap; /* 禁止换行 */
  text-overflow: ellipsis; /* 显示省略号 */
}